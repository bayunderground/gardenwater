# Copy this file to .env (gitignored) and fill in real values.
# Values here are secrets — never commit .env.
# Lines are KEY=VALUE; existing environment variables always win.

# Telegram: get these from @BotFather and @userinfobot (or any chat-id bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional weather provider keys (open-meteo needs no key).
# A provider whose key is missing is simply skipped.
WEATHERAPI_KEY=

# OpenWeather provider is currently disabled (see D21 in DEVELOPMENT_PLAN.md);
# the key alone is not enough, it needs the One Call subscription.
OPENWEATHER_API_KEY=
